{
  "manifest_version": 3,
  "name": "WAckup - Copiloto CRM y Respaldo Local para WhatsApp Web",
  "version": "3.1.0",
  "description": "WAckup 3.1: Copiloto nativo sidePanel, CRM comercial, atención y respaldo pasivo local para WhatsApp Web",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://192.168.*/*",
    "http://10.*/*",
    "http://172.16.*/*",
    "http://172.17.*/*",
    "http://172.18.*/*",
    "http://172.19.*/*",
    "http://172.20.*/*",
    "http://172.21.*/*",
    "http://172.22.*/*",
    "http://172.23.*/*",
    "http://172.24.*/*",
    "http://172.25.*/*",
    "http://172.26.*/*",
    "http://172.27.*/*",
    "http://172.28.*/*",
    "http://172.29.*/*",
    "http://172.30.*/*",
    "http://172.31.*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir Copiloto WAckup"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["crypto_sync.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["viewer_bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
