# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Directorio unificado de datos de usuario (base de datos, multimedia, backups, logs)
data/

# Archivos y carpetas heredados (privacidad de mensajes)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
media/
backups/
logs/
*.log
*.tmp
.DS_Store
Thumbs.db
desktop.ini

# Entornos virtuales e IDEs
.env
.venv
env/
venv/
.idea/
.vscode/

# Ignorar archivos JSON de dumps (pero mantener los de la extensión)
*.json
!extension/manifest.json

# Capturas, documentos internos de planificación y depuración local
Errores/
scratch/
.restart_flag
PLAN_EVOLUCION_WACKUP_V3.md
PROMPTS_WACKUP_V3.md

# Paquetes de distribución y runtime embebido de Python
runtime/
dist/
tools/.cache/

# Exportaciones HTML de chats (evitar subir conversaciones exportadas por error)
*.html
!web/*.html
!extension/**/*.html
